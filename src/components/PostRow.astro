---
import { formatDate, postReadingTime } from '../lib/content';
import type { Post } from '../lib/content';

interface Props {
  post: Post;
  index?: number;
}

const { post, index } = Astro.props;
const { title, slug, summary, date } = post.data;
const href = `/blog/${slug}/`;
const indexLabel = index ? String(index).padStart(2, '0') : null;
const revealDelay = `${Math.min((index ?? 1) - 1, 6) * 40}ms`;
---

<article class="post-row" data-reveal style={`--reveal-delay: ${revealDelay}`}>
  <div class="post-meta">
    {indexLabel && <span class="post-index">{indexLabel}</span>}
    <span class="post-date">{formatDate(date)}</span>
  </div>
  <div class="post-main">
    <h3 class="post-title">
      <a href={href}>{title}</a>
    </h3>
    <p class="post-summary">{summary}</p>
  </div>
  <div class="post-time">{postReadingTime(post)} 分钟</div>
  <span class="post-arrow" aria-hidden="true">↗</span>
</article>
