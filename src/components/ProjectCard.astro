---
import { formatDate } from '../lib/content';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  variant?: 'feature' | 'grid';
  index?: number;
}

const { project, variant = 'grid', index } = Astro.props;
const { title, slug, summary, cover, role, stack, date } = project.data;
const href = `/projects/${slug}/`;
const year = formatDate(date).slice(0, 4);
const indexLabel = index ? String(index).padStart(2, '0') : null;
const revealDelay = `${Math.min((index ?? 1) - 1, 5) * 60}ms`;
---

{variant === 'feature' ? (
  <article class="work-item" data-reveal style={`--reveal-delay: ${revealDelay}`}>
    <a class="work-cover" href={href} tabindex="-1" aria-hidden="true">
      {cover && (
        <img src={cover} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      )}
      {indexLabel && <span class="cover-badge">{indexLabel}</span>}
      <span class="cover-open">↗</span>
    </a>
    <div class="work-body">
      <div class="work-meta">
        {indexLabel && <span class="work-index">{indexLabel}</span>}
        <span>{year}</span>
        <span>{role}</span>
      </div>
      <h3 class="work-title">
        <a href={href}>{title}</a>
      </h3>
      <p class="work-summary">{summary}</p>
      <div class="stack">
        {stack.map((item) => <span class="chip">{item}</span>)}
      </div>
      <a class="read-more" href={href}>
        查看项目 <span class="arrow">→</span>
      </a>
    </div>
  </article>
) : (
  <article class="project-card" data-reveal style={`--reveal-delay: ${revealDelay}`}>
    <a class="work-cover" href={href} tabindex="-1" aria-hidden="true">
      {cover && (
        <img src={cover} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
      )}
      {indexLabel && <span class="cover-badge">{indexLabel}</span>}
      <span class="cover-open">↗</span>
    </a>
    <div class="project-card-body">
      <div class="work-meta">
        <span>{role}</span>
      </div>
      <h3 class="work-title">
        <a href={href}>{title}</a>
      </h3>
      <p class="work-summary">{summary}</p>
      <div class="stack">
        {stack.slice(0, 3).map((item) => <span class="chip">{item}</span>)}
        {stack.length > 3 && <span class="chip">+{stack.length - 3}</span>}
      </div>
      <div class="project-card-foot">
        <span class="project-year">{year}</span>
        <a class="read-more" href={href}>
          查看项目 <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </article>
)}
