---
import PostRow from './PostRow.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../lib/content';
import { PAGE_SIZE } from '../lib/site';

interface Props {
  posts: Post[];
  page: number;
  totalPages: number;
  total: number;
}

const { posts, page, totalPages, total } = Astro.props;
const startIndex = (page - 1) * PAGE_SIZE;
---

<section class="page-hero" data-watermark="WRITING">
  <div class="container">
    <p class="eyebrow">Writing / Index</p>
    <h1 class="page-title">文章</h1>
    <p class="page-lead">
      关于前端工程、内容系统与长期维护的思考。不定期更新，先写清楚，再写多。
    </p>
    <p class="count-note">{total} 篇 · 第 {page} 页</p>
  </div>
</section>

<div class="container">
  <div class="post-list">
    {posts.length === 0 ? (
      <p class="empty-state">还没有发布文章。可以先去 <a href="/projects/">看看项目</a>。</p>
    ) : (
      posts.map((post, index) => (
        <PostRow post={post} index={startIndex + index + 1} />
      ))
    )}
  </div>
  {totalPages > 1 && <Pagination page={page} totalPages={totalPages} />}
</div>
