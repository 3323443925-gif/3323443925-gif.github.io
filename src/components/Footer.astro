---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <p class="eyebrow">Stay in touch</p>
      <h2 class="footer-title">有项目、文章或想法，<br />欢迎聊聊。</h2>
      <p class="footer-desc">
        这个站点用来记录作品与写作。你可以通过 GitHub 或邮件找到我。
      </p>
    </div>

    <div class="footer-col">
      <h3>站内</h3>
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>

    <div class="footer-col">
      <h3>联系</h3>
      <a href="/about/#contact">联系我</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="/blog/">最新文章</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} {site.name}</span>
    <span>Built with Astro · Hosted on GitHub Pages</span>
  </div>
</footer>
