---
// Interactive signal field: floating nodes with cursor repulsion.
---

<div class="particle-field" aria-hidden="true">
  <canvas class="particle-canvas" data-particles="0"></canvas>
  <noscript><div class="hero-art"></div></noscript>
</div>

<script>
  type Particle = {
    x: number;
    y: number;
    homeX: number;
    homeY: number;
    vx: number;
    vy: number;
    phase: number;
    size: number;
    alpha: number;
    hub: boolean;
  };

  const hero = document.querySelector<HTMLElement>('.hero');
  const canvas = document.querySelector<HTMLCanvasElement>('.particle-canvas');
  const context = canvas?.getContext('2d');

  if (hero && canvas && context) {
    const heroEl = hero;
    const canvasEl = canvas;
    const ctx = context;
    const media = window.matchMedia('(prefers-reduced-motion: reduce)');
    const seed = 20261117;
    const linkDistance = 158;
    const cursorRadius = 185;
    const cobalt = '#7d95ff';
    const signal = '#ff6a3d';
    const cream = '#f2eee4';

    let reduced = media.matches;
    let particles: Particle[] = [];
    let width = 0;
    let height = 0;
    let dpr = 1;
    let raf = 0;
    let lastFrame = 0;
    let running = false;
    let inView = true;
    let resizeTimer = 0;
    let pointer = { x: 0, y: 0, active: false };

    function mulberry32(value: number) {
      let a = value;

      return function random() {
        a |= 0;
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function initialise() {
      width = heroEl.clientWidth;
      height = heroEl.clientHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);

      canvasEl.width = Math.round(width * dpr);
      canvasEl.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const rng = mulberry32(seed);
      const target = Math.round(
        Math.min(136, Math.max(56, (width * height) / 8000)),
      );
      const cols = Math.ceil(Math.sqrt(target * 1.45));
      const rows = Math.ceil(target / cols);
      const marginX = Math.max(24, width * 0.03);
      const marginY = Math.max(24, height * 0.04);

      particles = [];

      for (let row = 0; row < rows; row += 1) {
        for (let col = 0; col < cols; col += 1) {
          if (particles.length >= target) break;
          if (rng() < 0.08) continue;

          const homeX =
            marginX +
            (col / Math.max(1, cols - 1)) * (width - marginX * 2) +
            (rng() - 0.5) * 34;
          const homeY =
            marginY +
            (row / Math.max(1, rows - 1)) * (height - marginY * 2) +
            (rng() - 0.5) * 34;

          particles.push({
            x: homeX,
            y: homeY,
            homeX,
            homeY,
            vx: 0,
            vy: 0,
            phase: rng() * Math.PI * 2,
            size: 1.2 + rng() * 1.7,
            alpha: 0.5 + rng() * 0.45,
            hub: false,
          });
        }
      }

      const degrees = particles.map((particle, index) => {
        let degree = 0;
        for (let other = 0; other < particles.length; other += 1) {
          if (other === index) continue;
          const dx = particle.homeX - particles[other].homeX;
          const dy = particle.homeY - particles[other].homeY;
          if (dx * dx + dy * dy < linkDistance * linkDistance) degree += 1;
        }
        return degree;
      });

      const hubs = new Set(
        degrees
          .map((degree, index) => ({ degree, index }))
          .sort((a, b) => b.degree - a.degree)
          .slice(0, 3)
          .map((item) => item.index),
      );

      for (const [index, particle] of particles.entries()) {
        particle.hub = hubs.has(index);
        if (particle.hub) {
          particle.size += 0.8;
          particle.alpha = 0.9;
        }
      }

      canvasEl.dataset.particles = String(particles.length);

      if (reduced) {
        stop();
        draw();
      }
    }

    function step(delta: number) {
      const time = performance.now() * 0.0004;

      for (const particle of particles) {
        particle.vx += Math.sin(time + particle.phase) * 0.004 * delta;
        particle.vy += Math.cos(time * 1.17 + particle.phase) * 0.004 * delta;
        particle.vx += (particle.homeX - particle.x) * 0.003 * delta;
        particle.vy += (particle.homeY - particle.y) * 0.003 * delta;

        if (pointer.active) {
          const dx = particle.x - pointer.x;
          const dy = particle.y - pointer.y;
          const distance = Math.hypot(dx, dy);

          if (distance > 0.001 && distance < cursorRadius) {
            const force = (1 - distance / cursorRadius) ** 2;
            particle.vx += (dx / distance) * force * 3.2 * delta;
            particle.vy += (dy / distance) * force * 3.2 * delta;
          }
        }

        const friction = Math.pow(0.94, delta);
        particle.vx *= friction;
        particle.vy *= friction;
        particle.x += particle.vx * delta;
        particle.y += particle.vy * delta;

        if (particle.x < 6) {
          particle.x = 6;
          particle.vx *= -0.5;
        } else if (particle.x > width - 6) {
          particle.x = width - 6;
          particle.vx *= -0.5;
        }

        if (particle.y < 6) {
          particle.y = 6;
          particle.vy *= -0.5;
        } else if (particle.y > height - 6) {
          particle.y = height - 6;
          particle.vy *= -0.5;
        }
      }
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);
      ctx.lineCap = 'round';

      for (let i = 0; i < particles.length; i += 1) {
        const a = particles[i];

        for (let j = i + 1; j < particles.length; j += 1) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const distanceSq = dx * dx + dy * dy;

          if (distanceSq > linkDistance * linkDistance) continue;

          const distance = Math.sqrt(distanceSq);
          const strength = 1 - distance / linkDistance;
          const isSignal = a.hub || b.hub;

          ctx.globalAlpha = strength * (isSignal ? 0.32 : 0.26);
          ctx.strokeStyle = isSignal ? signal : cobalt;
          ctx.lineWidth = 0.6 + strength * 0.9;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      for (const particle of particles) {
        if (particle.hub) {
          ctx.globalAlpha = 0.18;
          ctx.strokeStyle = signal;
          ctx.lineWidth = 0.9;
          ctx.beginPath();
          ctx.arc(particle.x, particle.y, particle.size + 17, 0, Math.PI * 2);
          ctx.stroke();

          ctx.globalAlpha = 0.5;
          ctx.setLineDash([3, 5]);
          ctx.beginPath();
          ctx.arc(particle.x, particle.y, particle.size + 8, 0, Math.PI * 2);
          ctx.stroke();
          ctx.setLineDash([]);
        }

        ctx.globalAlpha = particle.alpha;
        ctx.fillStyle = particle.hub ? signal : cream;
        ctx.beginPath();
        ctx.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
        ctx.fill();

        if (particle.hub) {
          ctx.globalAlpha = 0.9;
          ctx.fillStyle = cream;
          ctx.beginPath();
          ctx.arc(
            particle.x,
            particle.y,
            Math.max(1, particle.size - 1.2),
            0,
            Math.PI * 2,
          );
          ctx.fill();
        }
      }

      if (pointer.active) {
        ctx.strokeStyle = cobalt;
        ctx.globalAlpha = 0.36;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(pointer.x, pointer.y, 32, 0, Math.PI * 2);
        ctx.stroke();

        ctx.globalAlpha = 0.16;
        ctx.beginPath();
        ctx.arc(pointer.x, pointer.y, 58, 0, Math.PI * 2);
        ctx.stroke();

        ctx.globalAlpha = 0.8;
        ctx.lineWidth = 1.1;
        for (let tick = 0; tick < 4; tick += 1) {
          const angle = (Math.PI / 2) * tick;
          const inner = 34;
          const outer = 40;
          ctx.beginPath();
          ctx.moveTo(
            pointer.x + Math.cos(angle) * inner,
            pointer.y + Math.sin(angle) * inner,
          );
          ctx.lineTo(
            pointer.x + Math.cos(angle) * outer,
            pointer.y + Math.sin(angle) * outer,
          );
          ctx.stroke();
        }

        ctx.globalAlpha = 0.9;
        ctx.fillStyle = cobalt;
        ctx.beginPath();
        ctx.arc(pointer.x, pointer.y, 1.4, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalAlpha = 1;
    }

    function render(now: number) {
      if (!running) return;

      const delta = lastFrame ? Math.min(2, (now - lastFrame) / 16.667) : 1;
      lastFrame = now;
      step(delta);
      draw();
      raf = window.requestAnimationFrame(render);
    }

    function start() {
      if (reduced || running) return;
      running = true;
      lastFrame = 0;
      raf = window.requestAnimationFrame(render);
    }

    function stop() {
      running = false;
      window.cancelAnimationFrame(raf);
      raf = 0;
    }

    function handlePointerMove(event: PointerEvent) {
      if (event.pointerType === 'touch') return;

      const rect = heroEl.getBoundingClientRect();
      pointer = {
        x: event.clientX - rect.left,
        y: event.clientY - rect.top,
        active: true,
      };
    }

    heroEl.addEventListener('pointermove', handlePointerMove);
    heroEl.addEventListener('pointerleave', () => {
      pointer.active = false;
    });
    window.addEventListener(
      'scroll',
      () => {
        pointer.active = false;
      },
      { passive: true },
    );

    const observer = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? true;
        if (inView) {
          start();
        } else {
          stop();
        }
      },
      { threshold: 0.01 },
    );
    observer.observe(heroEl);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stop();
      } else if (inView) {
        start();
      }
    });

    media.addEventListener('change', (event) => {
      reduced = event.matches;
      if (reduced) {
        stop();
        draw();
      } else {
        start();
      }
    });

    const resizeObserver = new ResizeObserver(() => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (
          Math.abs(heroEl.clientWidth - width) < 1 &&
          Math.abs(heroEl.clientHeight - height) < 1
        ) {
          return;
        }
        initialise();
        if (!reduced) start();
      }, 140);
    });
    resizeObserver.observe(heroEl);

    initialise();

    if (!reduced) {
      start();
    }
  }
</script>
