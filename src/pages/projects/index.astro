---
import BaseLayout from '../../components/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { publicProjects } from '../../lib/content';

const projects = publicProjects(await getCollection('projects'));
---

<BaseLayout title="项目" description="公开项目与作品：职责、技术栈与关键成果。">
  <section class="page-hero" data-watermark="WORK">
    <div class="container">
      <p class="eyebrow">Work / Index</p>
      <h1 class="page-title">项目</h1>
      <p class="page-lead">
        这里是我的项目实践：从 Servlet 到 Spring Boot，再到接入 AI 能力的全栈系统，
        以及正在做的西语视频二维码产品。每个项目都写清楚做了什么、怎么设计、踩过哪些坑。
      </p>
      <p class="count-note">{projects.length} 个公开项目</p>
    </div>
  </section>

  <div class="container">
    {projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((project, index) => (
          <ProjectCard project={project} index={index + 1} />
        ))}
      </div>
    ) : (
      <p class="empty-state">暂无公开项目，新的内容正在整理中。</p>
    )}
  </div>
</BaseLayout>
