---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { publicProjects, formatDate } from '../../lib/content';
import type { Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = publicProjects(await getCollection('projects'));
  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      prev: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const year = formatDate(data.date).slice(0, 4);
const demoHost = data.demoUrl
  ? new URL(data.demoUrl).hostname.replace(/^www\./, '')
  : null;
const links = [
  ...(data.repoUrl
    ? [{ label: '代码仓库', url: data.repoUrl, display: '代码仓库' }]
    : []),
  ...(data.demoUrl && demoHost
    ? [{ label: '线上站点', url: data.demoUrl, display: demoHost }]
    : []),
];
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.cover ?? '/og-default.png'}
>
  <article>
    <header class="article-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="面包屑导航">
          <a href="/projects/">项目</a>
          <span>/</span>
          <span>{data.title}</span>
        </nav>

        <h1 class="article-title">{data.title}</h1>
        <p class="article-summary">{data.summary}</p>

        {data.demoUrl && demoHost && (
          <a
            class="project-live"
            href={data.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`打开 ${data.title} 线上网站：${data.demoUrl}`}
          >
            <span class="project-live-dot" aria-hidden="true"></span>
            <span class="project-live-label">线上站点</span>
            <span class="project-live-url">{demoHost}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )}

        <div class="stack">
          {data.stack.map((item) => <span class="chip">{item}</span>)}
        </div>

        <dl class="fact-grid">
          <div>
            <dt>年份</dt>
            <dd>{year}</dd>
          </div>
          <div>
            <dt>职责</dt>
            <dd>{data.role}</dd>
          </div>
          <div>
            <dt>链接</dt>
            <dd>
              {links.length > 0
                ? links.map((link, index) => (
                    <>
                      {index > 0 && ' · '}
                      <a href={link.url} target="_blank" rel="noopener noreferrer">
                        {link.display} ↗
                      </a>
                    </>
                  ))
                : '暂未公开'}
            </dd>
          </div>
        </dl>

        {data.highlights.length > 0 && (
          <ul class="highlights">
            {data.highlights.map((item) => <li>{item}</li>)}
          </ul>
        )}

        {data.cover && (
          <figure class="detail-cover">
            <img
              src={data.cover}
              alt={`${data.title} 的项目封面`}
              width="1600"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )}
      </div>
    </header>

    {data.videoUrl && data.videoPoster && (
      <section class="section detail-demo" aria-labelledby="demo-heading">
        <div class="container">
          <p class="section-label">Demo</p>
          <h2 class="section-title" id="demo-heading">演示视频</h2>
          <VideoPlayer
            src={data.videoUrl}
            poster={data.videoPoster}
            title={data.title}
          />
        </div>
      </section>
    )}

    <div class="container detail-body">
      <div class="prose">
        <Content />
      </div>

      {(prev || next) && (
        <nav class="adjacent-nav" aria-label="项目导航">
          {prev && (
            <a href={`/projects/${prev.data.slug}/`}>
              <span class="dir">← 上一个项目</span>
              <span class="name">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="next" href={`/projects/${next.data.slug}/`}>
              <span class="dir">下一个项目 →</span>
              <span class="name">{next.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </article>
</BaseLayout>
