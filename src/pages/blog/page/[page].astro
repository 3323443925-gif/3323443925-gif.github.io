---
import BaseLayout from '../../../components/BaseLayout.astro';
import BlogArchive from '../../../components/BlogArchive.astro';
import { getCollection } from 'astro:content';
import { publicPosts } from '../../../lib/content';
import { PAGE_SIZE } from '../../../lib/site';
import type { Post } from '../../../lib/content';

export async function getStaticPaths() {
  const all = publicPosts(await getCollection('blog'));
  const total = all.length;
  const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
        page,
        totalPages,
        total,
      },
    };
  });
}

interface Props {
  posts: Post[];
  page: number;
  totalPages: number;
  total: number;
}

const { posts, page, totalPages, total } = Astro.props;
---

<BaseLayout
  title={`文章 · 第 ${page} 页`}
  description="技术写作与工程记录：前端、内容系统与长期维护。"
>
  <BlogArchive posts={posts} page={page} totalPages={totalPages} total={total} />
</BaseLayout>
