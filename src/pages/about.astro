---
import BaseLayout from '../components/BaseLayout.astro';
import { site } from '../lib/site';

const githubHandle = site.github
  .replace(/^https?:\/\/github\.com\//, '')
  .replace(/\/$/, '');
---

<BaseLayout
  title="关于"
  description="软件技术专业学生：Java 后端、AI 全栈学习路径与联系方式。"
>
  <section class="page-hero" data-watermark="ABOUT">
    <div class="container">
      <p class="eyebrow">About / Contact</p>
      <h1 class="page-title">关于</h1>
      <p class="page-lead">
        从 Java 后端出发，理解完整系统。写代码，也写清楚每一次取舍。
      </p>
    </div>
  </section>

  <div class="about-main">
    <div class="container about-grid">
      <aside class="about-side">
        <div class="profile-card" data-reveal>
          <span class="profile-stamp" aria-hidden="true">✳</span>
          <div class="profile-mark" aria-hidden="true">{site.monogram}</div>
          <h2>{site.name}</h2>
          <p class="profile-role">{site.role}</p>
          <dl class="profile-facts">
            <div>
              <dt>状态</dt>
              <dd>在读学生</dd>
            </div>
            <div>
              <dt>方向</dt>
              <dd>Java 后端 / AI 全栈</dd>
            </div>
            <div>
              <dt>GitHub</dt>
              <dd>
                <a href={site.github} target="_blank" rel="noopener noreferrer">
                  @{githubHandle} ↗
                </a>
              </dd>
            </div>
            <div>
              <dt>本站</dt>
              <dd>Astro · GitHub Pages</dd>
            </div>
          </dl>
        </div>
      </aside>

      <div>
        <section class="about-section" data-reveal>
          <h2>简介</h2>
          <p class="about-intro">
            我是软件技术专业的学生，方向偏后端。日常主要写 Java，用 Spring Boot、MyBatis 和 MySQL 做项目，也在学习如何把大模型能力接进真实项目。
          </p>
          <p>
            这个站点用 Astro 构建，内容放在 GitHub，托管在 GitHub Pages。写文章是为了把项目里的判断和踩过的坑记下来，也给未来的自己留一份索引。
          </p>
        </section>

        <section class="about-section" data-reveal>
          <h2>技术栈</h2>
          <dl>
            <div class="skill-group">
              <dt>语言</dt>
              <dd>Java / SQL / JavaScript / Python（学习中）</dd>
            </div>
            <div class="skill-group">
              <dt>后端</dt>
              <dd>Spring Boot / MyBatis / Servlet / RESTful API</dd>
            </div>
            <div class="skill-group">
              <dt>数据</dt>
              <dd>MySQL / JDBC / 数据库设计</dd>
            </div>
            <div class="skill-group">
              <dt>AI 应用</dt>
              <dd>Spring AI / DeepSeek API / 结构化输出</dd>
            </div>
            <div class="skill-group">
              <dt>工具</dt>
              <dd>Git / Maven / Linux / Postman</dd>
            </div>
          </dl>
        </section>

        <section class="about-section" data-reveal>
          <h2>学习路径</h2>
          <ol class="timeline">
            <li>
              <span class="time">现在</span>
              <div>
                <strong>软件技术专业 · 在读</strong>
                <p>系统学习 Java、数据库与后端工程，目标方向是 AI 全栈开发。</p>
              </div>
            </li>
            <li>
              <span class="time">2026</span>
              <div>
                <strong>项目实践</strong>
                <p>完成校园招聘平台、员工管理系统与电商系统三个 Java 项目，覆盖 Servlet 与 Spring Boot；目前在做面向西语市场的视频二维码产品 QRveo。</p>
              </div>
            </li>
            <li>
              <span class="time">持续</span>
              <div>
                <strong>工程基础</strong>
                <p>数据结构、计算机网络、操作系统与 Git，边学边用，尽量放进真实项目里验证。</p>
              </div>
            </li>
          </ol>
        </section>

        <section class="about-section" id="contact" data-reveal>
          <h2>联系</h2>
          <p>不在页面上公开邮箱。可以通过 GitHub 找到我，或在任意仓库提 Issue。</p>
          <div class="contact-card">
            <div>
              <p class="mono-label">GitHub</p>
              <p>@{githubHandle} · 代码、项目与这个站点的源码。</p>
            </div>
            <a
              class="copy-btn"
              href={site.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              前往 GitHub <span class="arrow">↗</span>
            </a>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
