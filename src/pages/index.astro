---
import BaseLayout from '../components/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import ParticleField from '../components/ParticleField.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { getCollection } from 'astro:content';
import { publicProjects, publicPosts } from '../lib/content';
import { site } from '../lib/site';

const allProjects = publicProjects(await getCollection('projects'));
const projects = allProjects.slice(0, 6);
const demos = allProjects.flatMap((project) => {
  const { videoUrl, videoPoster, demoUrl } = project.data;
  if (!videoUrl || !videoPoster) return [];
  return [
    {
      project,
      videoUrl,
      videoPoster,
      host: demoUrl
        ? new URL(demoUrl).hostname.replace(/^www\./, '')
        : null,
    },
  ];
});
const posts = publicPosts(await getCollection('blog')).slice(0, 5);

const tickerItems = ['Java', 'Spring Boot', 'MySQL', 'MyBatis', 'AI 全栈', '系统设计'];
const tickerLoop = [
  ...tickerItems,
  ...tickerItems,
  ...tickerItems,
  ...tickerItems,
];
---

<BaseLayout>
  <section class="hero">
    <ParticleField />
    <div class="container">
      <div class="hero-top">
        <p class="eyebrow"><span class="eyebrow-star" aria-hidden="true">✳</span> Portfolio · Blog</p>
        <p class="hero-status"><span class="status-dot"></span>{site.status}</p>
      </div>

      <h1 class="hero-title">
        {site.name}<span class="hero-dot" aria-hidden="true">.</span><span class="hero-caret" aria-hidden="true">_</span>
      </h1>

      <div class="hero-body">
        <div class="hero-copy">
          <p class="hero-sub">{site.tagline}</p>
          <p class="hero-lead">{site.intro}</p>
          <div class="actions">
            <a class="button primary" href="/projects/">查看项目 <span class="arrow">→</span></a>
            <a class="button secondary" href="/about/#contact">联系我</a>
          </div>
        </div>

        <aside class="hero-index" aria-label="页面索引">
          <p class="mono-label">Index</p>
          <ol>
            <li>
              <a href="#demos"><span class="idx">01</span>项目演示<span class="arr">↘</span></a>
            </li>
            <li>
              <a href="#projects"><span class="idx">02</span>精选项目<span class="arr">↘</span></a>
            </li>
            <li>
              <a href="#writing"><span class="idx">03</span>最新文章<span class="arr">↘</span></a>
            </li>
            <li>
              <a href="/about/"><span class="idx">04</span>关于与联系<span class="arr">↘</span></a>
            </li>
          </ol>
          <dl class="hero-console">
            <div><dt>NOW</dt><dd><a href="https://lwcqr.qrveo.com/" target="_blank" rel="noopener noreferrer">QRveo ↗</a></dd></div>
            <div><dt>STACK</dt><dd>Java / Spring Boot / MySQL</dd></div>
            <div><dt>MODE</dt><dd>AI Full-stack</dd></div>
            <div><dt>SEED</dt><dd>20261117</dd></div>
            <div><dt>FIELD</dt><dd>鼠标靠近扩散</dd></div>
          </dl>
        </aside>
      </div>
    </div>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <div class="ticker-group">
            {tickerLoop.map((item) => (
              <>
                <span>{item}</span>
                <span class="tick">✳</span>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  {demos.length > 0 && (
    <section class="section" id="demos">
      <div class="container">
        <SectionHead label="01 / Live demo" title="项目演示" />
        <div class="demo-grid">
          {demos.map((demo, index) => {
            const data = demo.project.data;
            return (
              <article
                class="demo-card"
                data-reveal
                style={`--reveal-delay:${index * 60}ms`}
              >
                <VideoPlayer
                  src={demo.videoUrl}
                  poster={demo.videoPoster}
                  title={data.title}
                />
                <div class="demo-body">
                  <div class="demo-meta">
                    <span>DEMO / {String(index + 1).padStart(2, '0')}</span>
                    <span>{data.role}</span>
                  </div>
                  <h3 class="demo-title">
                    <a href={`/projects/${data.slug}/`}>{data.title}</a>
                  </h3>
                  <p class="demo-desc">{data.summary}</p>
                  <div class="demo-actions">
                    {demo.host && data.demoUrl && (
                      <a
                        href={data.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {demo.host} ↗
                      </a>
                    )}
                    <a href={`/projects/${data.slug}/`}>项目详情 →</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="section" id="projects">
    <div class="container">
      <SectionHead
        label="02 / Selected work"
        title="精选项目"
        href="/projects/"
        linkText="全部项目"
      />
      {projects.length > 0 ? (
        <div class="work-list">
          {projects.map((project, index) => (
            <ProjectCard project={project} variant="feature" index={index + 1} />
          ))}
        </div>
      ) : (
        <p class="empty-state">还没有公开项目，新的内容正在整理中。</p>
      )}
    </div>
  </section>

  <section class="section" id="writing">
    <div class="container">
      <SectionHead
        label="03 / Latest writing"
        title="最新文章"
        href="/blog/"
        linkText="全部文章"
      />
      {posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post, index) => <PostRow post={post} index={index + 1} />)}
        </div>
      ) : (
        <p class="empty-state">还没有发布文章，可以先看看项目。</p>
      )}
    </div>
  </section>
</BaseLayout>
