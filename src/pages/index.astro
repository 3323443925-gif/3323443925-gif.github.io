---
import BaseLayout from '../components/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import ParticleField from '../components/ParticleField.astro';
import { getCollection } from 'astro:content';
import { publicProjects, publicPosts } from '../lib/content';
import { site } from '../lib/site';

const projects = publicProjects(await getCollection('projects')).slice(0, 6);
const posts = publicPosts(await getCollection('blog')).slice(0, 5);

const tickerItems = ['Java', 'Spring Boot', 'MySQL', 'MyBatis', 'AI 全栈', '系统设计'];
const tickerLoop = [
  ...tickerItems,
  ...tickerItems,
  ...tickerItems,
  ...tickerItems,
];
---

<BaseLayout>
  <section class="hero">
    <ParticleField />
    <div class="container">
      <div class="hero-top">
        <p class="eyebrow"><span class="eyebrow-star" aria-hidden="true">✳</span> Portfolio · Blog</p>
        <p class="hero-status"><span class="status-dot"></span>{site.status}</p>
      </div>

      <h1 class="hero-title">
        {site.name}<span class="hero-dot" aria-hidden="true">.</span><span class="hero-caret" aria-hidden="true">_</span>
      </h1>

      <div class="hero-body">
        <div class="hero-copy">
          <p class="hero-sub">{site.tagline}</p>
          <p class="hero-lead">{site.intro}</p>
          <div class="actions">
            <a class="button primary" href="/projects/">查看项目 <span class="arrow">→</span></a>
            <a class="button secondary" href="/about/#contact">联系我</a>
          </div>
        </div>

        <aside class="hero-index" aria-label="页面索引">
          <p class="mono-label">Index</p>
          <ol>
            <li>
              <a href="#projects"><span class="idx">01</span>精选项目<span class="arr">↘</span></a>
            </li>
            <li>
              <a href="#writing"><span class="idx">02</span>最新文章<span class="arr">↘</span></a>
            </li>
            <li>
              <a href="/about/"><span class="idx">03</span>关于与联系<span class="arr">↘</span></a>
            </li>
          </ol>
          <dl class="hero-console">
            <div><dt>NOW</dt><dd><a href="https://lwcqr.qrveo.com/" target="_blank" rel="noopener noreferrer">QRveo ↗</a></dd></div>
            <div><dt>STACK</dt><dd>Java / Spring Boot / MySQL</dd></div>
            <div><dt>MODE</dt><dd>AI Full-stack</dd></div>
            <div><dt>SEED</dt><dd>20261117</dd></div>
            <div><dt>FIELD</dt><dd>鼠标靠近扩散</dd></div>
          </dl>
        </aside>
      </div>
    </div>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <div class="ticker-group">
            {tickerLoop.map((item) => (
              <>
                <span>{item}</span>
                <span class="tick">✳</span>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <SectionHead
        label="01 / Selected work"
        title="精选项目"
        href="/projects/"
        linkText="全部项目"
      />
      {projects.length > 0 ? (
        <div class="work-list">
          {projects.map((project, index) => (
            <ProjectCard project={project} variant="feature" index={index + 1} />
          ))}
        </div>
      ) : (
        <p class="empty-state">还没有公开项目，新的内容正在整理中。</p>
      )}
    </div>
  </section>

  <section class="section" id="writing">
    <div class="container">
      <SectionHead
        label="02 / Latest writing"
        title="最新文章"
        href="/blog/"
        linkText="全部文章"
      />
      {posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post, index) => <PostRow post={post} index={index + 1} />)}
        </div>
      ) : (
        <p class="empty-state">还没有发布文章，可以先看看项目。</p>
      )}
    </div>
  </section>
</BaseLayout>
